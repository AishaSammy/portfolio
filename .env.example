# Contact form (https://resend.com). Set these in Vercel > Project > Settings > Environment Variables
NUXT_RESEND_API_KEY=
NUXT_CONTACT_TO_EMAIL=
# Must be a sender allowed by your Resend account (onboarding@resend.dev works for testing)
NUXT_CONTACT_FROM_EMAIL=

# Google Tag Manager container id (e.g. GTM-XXXXXXX). Leave empty to disable.
GTM_ID=
